rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Siapa saja boleh melihat/mengunduh (READ) foto produk, banner promo, logo, dan aset website
    // Hanya Admin yang terotentikasi (login) yang boleh mengunggah, mengganti, atau menghapus file (WRITE)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
