rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. READ PUBLIK: Siapa saja boleh membaca katalog motor, hero, promo, ulasan, kontak, dan QnA
    match /{document=**} {
      allow read: if true;
    }

    // 2. TANYA JAWAB (QnA):
    // - Pengunjung publik boleh membuat (CREATE) pertanyaan baru tanpa login
    // - Validasi: nama (2-50 karakter), pertanyaan (3-500 karakter)
    // - Admin terotentikasi memiliki akses penuh update & delete
    match /qna/{qnaId} {
      allow create: if request.resource.data.nama is string
                    && request.resource.data.nama.size() >= 2
                    && request.resource.data.nama.size() <= 50
                    && request.resource.data.pertanyaan is string
                    && request.resource.data.pertanyaan.size() >= 3
                    && request.resource.data.pertanyaan.size() <= 500;
      allow update, delete: if request.auth != null;
    }

    // 3. KOLEKSI LAINNYA (products, hero, about, settings, testimonials):
    // - Hanya Admin yang terotentikasi yang boleh create, update, atau delete
    match /products/{docId} {
      allow write: if request.auth != null;
    }
    match /hero/{docId} {
      allow write: if request.auth != null;
    }
    match /about/{docId} {
      allow write: if request.auth != null;
    }
    match /settings/{docId} {
      allow write: if request.auth != null;
    }
    match /testimonials/{docId} {
      allow write: if request.auth != null;
    }
  }
}
